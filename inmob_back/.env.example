# Database
MONGODB_URI=mongodb://localhost:27017/inmob

# Server port (optional, defaults to 3000)
PORT=3000

# JWT Configuration (required, must be 32+ characters)
JWT_SECRET=your_super_secret_jwt_key_here_32_characters_minimum

# Image Storage Configuration
# Options: 'local' or 'cloudinary' (defaults to cloudinary)
IMAGE_STORAGE_TYPE=cloudinary

# Cloudinary Configuration (required when IMAGE_STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Environment (optional, one of: development, production, test)
NODE_ENV=development

# Local uploads base directory (optional, defaults to ./uploads when IMAGE_STORAGE_TYPE=local)
# UPLOADS_BASE_DIR=

# Production CORS (optional, comma-separated frontend URLs)
FRONTEND_URLS=http://localhost:3001

# Syndication (Phase 3) — disabled by default; the app boots without Redis/Meta
# Redis for BullMQ (docker-compose.yml at the repo root provides one)
REDIS_URL=redis://localhost:6379
# Subset of: meta-graph, xml-feed, json-feed (empty = syndication disabled)
SYNDICATION_CHANNELS=
# Shared secret for the Bull Board queue dashboard at /api/admin/queue-board
# (empty = board disabled; open it as .../queue-board?token=THIS_VALUE)
QUEUE_BOARD_TOKEN=
# Public site URL used in feed urlDetalle and social post links
PUBLIC_SITE_URL=http://localhost:3001

# Meta Graph API (only needed when meta-graph is enabled)
META_APP_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=            # long-lived Page token
META_GRAPH_VERSION=v23.0      # TODO: pin the current version when deploying
META_SANDBOX=true             # true = dry-run (log payloads, no API calls)
