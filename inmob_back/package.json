{
  "name": "inmob_back",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/check-platform.mjs && vitest run",
    "test:unit": "node scripts/check-platform.mjs && vitest run tests/unit",
    "test:watch": "node scripts/check-platform.mjs && vitest",
    "test:coverage": "node scripts/check-platform.mjs && vitest run --coverage",
    "start": "node scripts/check-platform.mjs && tsx --env-file-if-exists=.env src/server.ts",
    "dev": "node scripts/check-platform.mjs && nodemon --exec \"tsx --env-file-if-exists=.env src/server.ts\"",
    "build": "node scripts/check-platform.mjs && tsc",
            "create-admin": "tsx --env-file-if-exists=.env src/scripts/createAdmin.ts",
                "seed": "tsx --env-file-if-exists=.env src/scripts/seedDemoData.ts",
        "export-tour": "tsx --env-file-if-exists=.env src/scripts/exportTour.ts",
    "export-metrics": "tsx --env-file-if-exists=.env src/scripts/exportMetricsReport.ts",
    "gen-panorama": "tsx src/scripts/generatePanorama.ts",
    "migrate:batch1": "tsx --env-file-if-exists=.env src/scripts/migrateBatch1.ts",
    "migrate:batch2": "tsx --env-file-if-exists=.env src/scripts/migrateBatch2.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "bcryptjs": "3.0.3",
    "bullmq": "^6.3.4",
    "cloudinary": "2.10.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "^9.9.2",
    "multer": "2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
