    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
