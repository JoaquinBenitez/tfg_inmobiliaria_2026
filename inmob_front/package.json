{
  "name": "real-estate-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-platform.mjs && next dev -p 3001",
    "dev:default": "node scripts/check-platform.mjs && next dev",
    "build": "node scripts/check-platform.mjs && next build",
    "start": "node scripts/check-platform.mjs && next start",
    "start:3001": "node scripts/check-platform.mjs && next start -p 3001",
    "lint": "eslint .",
    "test": "node scripts/check-platform.mjs && vitest run",
    "test:watch": "node scripts/check-platform.mjs && vitest",
    "test:coverage": "node scripts/check-platform.mjs && vitest run --coverage",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:before": "node scripts/lighthouse.mjs --label before",
    "lighthouse:after": "node scripts/lighthouse.mjs --label after"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "5.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.1.1"
